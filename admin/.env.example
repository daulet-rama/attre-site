# Переменные окружения админки attré — образец без настоящих значений.
#
# Локально: скопируйте в admin/.env и заполните (cp .env.example .env). Файл .env в git НЕ кладите:
# репозиторий attre-site публичный, а там будут пароли и токен.
# Railway: Variables → Raw Editor — вставьте нужные строки (список для боевого запуска — README.md, «Деплой на Railway»).
#
# Значения пишите без кавычек — так файл одинаково понимают uvicorn --env-file, docker run --env-file и Railway.
# Комментарий — только отдельной строкой, начиная с #.


# ——— Хранилище ———

# github — читать и писать репозиторий через GitHub API (боевой режим, Railway; так и будет, если не задано);
# local  — рабочая копия репозитория на этом компьютере: коммиты локально, без push (разработка и тесты).
STORE=local

# Для STORE=github. Fine-grained токен GitHub ТОЛЬКО на репозиторий attre-site:
# Contents — Read and write, Actions — Read-only, Metadata — Read-only. Как создать — README.md.
# Секрет: никому не пересылать, не печатать в логах.
GITHUB_TOKEN=

# Для STORE=github. Репозиторий сайта: владелец/имя.
GITHUB_REPO=daulet-rama/attre-site

# Для STORE=github. Ветка, из которой GitHub Actions собирает сайт.
GITHUB_BRANCH=main

# Для STORE=local. Путь к рабочей копии репозитория сайта. Лучше отдельный клон или git worktree:
# админка делает в нём коммиты (git add / git rm / git commit) и не пушит.
LOCAL_REPO=/tmp/attre-test


# ——— Вход ———

# Пользователи админки: Имя:пароль;Имя2:пароль2 — например Дамира:<пароль>;Жанна:<пароль>.
# Имя видно на экране входа и в истории изменений (до 40 символов, без «:» и «;»).
# В пароле нельзя «;» — это разделитель записей; пробелы по краям обрезаются.
ADMIN_USERS=

# Только если ADMIN_USERS пуст: один общий пароль, имя пользователя будет «Админ».
ADMIN_PASSWORD=

# Ключ подписи cookie входа: 32+ случайных символа. Сгенерировать:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Если поменять — все выйдут из админки и войдут заново (способ «выйти на всех устройствах»).
SESSION_SECRET=


# ——— Сайт и служебное ———

# Адрес сайта (тема «Витрина», v4) со слешем на конце: кнопка «Открыть сайт ↗» и ссылки «Открыть товар на сайте».
# Не задан — берётся из GITHUB_REPO: https://<владелец>.github.io/<репозиторий>/v4/. Появится свой домен — поменять здесь.
SITE_URL=https://daulet-rama.github.io/attre-site/v4/

# Папка для временных загрузок фото (живут 24 ч) и кэша превью (14 дней). На Railway пропадает при перезапуске —
# это нормально: превью соберутся заново. Не задана — <системная временная папка>/attre-admin.
TMP_DIR=/tmp/attre-admin

# Порт. На Railway НЕ задавайте — он подставляет свой. Локально без Docker порт задаёт ключ uvicorn --port.
# PORT=8000
